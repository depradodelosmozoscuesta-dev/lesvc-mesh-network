<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0a0e27">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎧 Audio Messaging"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#00d4ff" />

        <TextView
            android:id="@+id/balanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 100 créditos"
            android:textSize="14sp"
            android:textColor="#00ff88"
            android:padding="8dp"
            android:background="#1a2a4a"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status Bar -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Listo"
        android:textSize="12sp"
        android:textColor="#00ff88"
        android:padding="8dp"
        android:background="#1a2a1a"
        android:layout_marginBottom="16dp"
        android:textStyle="italic" />

    <!-- Input Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📝 Ingresa texto:"
        android:textSize="14sp"
        android:textColor="#00d4ff"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/textInput"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Escribe texto aquí (A-Z, 0-9, . , ! ?)..."
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:background="#1a2a4a"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:textSize="14sp"
        android:gravity="top"
        android:inputType="textMultiLine" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:spacing="8dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnEncode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="▶ Reproducir"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#00a86b"
            android:textColor="#ffffff"
            android:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnDecode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="⏺ Grabar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#ff6b00"
            android:textColor="#ffffff"
            android:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✕ Limpiar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#cc0000"
            android:textColor="#ffffff"
            android:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Output Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎧 Decodificación:"
        android:textSize="14sp"
        android:textColor="#00d4ff"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1a2a4a"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textOutputL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="L: ---"
            android:textSize="12sp"
            android:textColor="#00ff88"
            android:layout_marginBottom="8dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textOutputR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R: ---"
            android:textSize="12sp"
            android:textColor="#ff00ff"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Credits Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:spacing="8dp">

        <Button
            android:id="@+id/btnCredits"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="💳 Créditos"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#4a00a8"
            android:textColor="#ffffff"
            android:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnDaily"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🎁 Bonus Diario"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#ffaa00"
            android:textColor="#ffffff"
            android:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Info Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="#1a2a4a">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 COSTOS:"
            android:textSize="11sp"
            android:textColor="#00d4ff"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Codificar: 5 créditos"
            android:textSize="10sp"
            android:textColor="#cccccc" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Decodificar: 3 créditos"
            android:textSize="10sp"
            android:textColor="#cccccc" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Bonus diario: 10 créditos"
            android:textSize="10sp"
            android:textColor="#cccccc" />
    </LinearLayout>

</LinearLayout>
