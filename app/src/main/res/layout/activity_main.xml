<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <!-- ENVIAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText
                android:id="@+id/textoMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/hint_mensaje"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minLines="3"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/contador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/texto_suave"
                android:textSize="13sp" />

            <TextView style="@style/Etiqueta" android:text="@string/modo" />

            <Spinner
                android:id="@+id/selectorProtocolo"
                android:layout_width="match_parent"
                android:layout_height="52dp" />

            <TextView
                android:id="@+id/avisoUltra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aviso_ultra"
                android:textColor="@color/aviso"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/etiquetaVolumen"
                style="@style/Etiqueta" />

            <SeekBar
                android:id="@+id/volumen"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="99" />

            <Button
                android:id="@+id/botonEnviar"
                style="@style/BotonGrande"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/enviar"
                android:text="@string/enviar" />
        </LinearLayout>

        <!-- ESCUCHAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/botonEscuchar"
                style="@style/BotonGrande"
                android:backgroundTint="@color/escuchar"
                android:text="@string/escuchar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nivel_micro"
                android:textColor="@color/texto_suave"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/nivelMicro"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/oirme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/oirme"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E3F2FD"
            android:padding="10dp"
            android:textColor="@color/primario"
            android:textSize="15sp" />

        <!-- MENSAJES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Etiqueta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/mensajes"
                android:textSize="17sp" />

            <Button
                android:id="@+id/botonLimpiar"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/limpiar"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/historial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tarjeta"
            android:lineSpacingExtra="4dp"
            android:minHeight="120dp"
            android:padding="12dp"
            android:text="@string/sin_mensajes"
            android:textColor="@color/texto"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
